# ───────── Splynx ─────────
# Administration > Main > API keys: create a key with READ access to
# Customers (customer, custom services, internet services) and Tariffs.
SPLYNX_URL=https://billing.savenet.co.ke
SPLYNX_API_KEY=
SPLYNX_API_SECRET=
# signature (default, recommended) or basic
SPLYNX_AUTH=signature

# How customers sign in to the TV app:
#   splynx = same login + password as the Splynx customer portal (recommended)
#   local  = customer login + an 8-character access code generated by the sync service
AUTH_MODE=splynx
# local mode only: write each customer's access code into this Splynx additional
# field so support can read it (create the field first; needs write access on the key)
SPLYNX_ACCESS_CODE_ATTRIBUTE=

# ───────── Media engine ─────────
# Created during setup: engine dashboard > API keys > "+" (name it "Flex")
JELLYFIN_API_KEY=
# Folder on this server holding Movies/, TV Shows/, Kids/ ...
MEDIA_PATH=/srv/media
# 127.0.0.1 = engine admin only reachable from this server (use an SSH tunnel);
# set to your server's LAN IP to reach the admin dashboard from the office network.
ENGINE_ADMIN_BIND=127.0.0.1

# ───────── Live TV ─────────
# M3U playlist (URL or path). group-title of each channel = channel group in packages.yaml
# e.g. https://iptv.provider/list.m3u  or  /config/channels.m3u
LIVETV_M3U=
# XMLTV programme guide (URL or path, .xml or .xml.gz), optional
LIVETV_EPG=
LIVETV_REFRESH_MINUTES=30
# Extra stream hosts allowed for live segments (comma-separated), if your CDN redirects
LIVETV_ALLOWED_HOSTS=

# ───────── Sync behaviour ─────────
# seconds between Splynx checks
SYNC_INTERVAL=300
# blocked (unpaid) customers lose TV access
SUSPEND_ON_BLOCKED=true
# remove accounts suspended this long (0 = never; watch history kept until then)
DELETE_AFTER_DAYS=30

# ───────── Your brand ─────────
BRAND_NAME=Flex
BRAND_TAGLINE=Movies, series and live TV, included with your internet.
BRAND_ACCENT=#E8A33D
BRAND_LOGO_URL=
BRAND_SUPPORT=Contact SaveNet Networks support.
UPGRADE_URL=https://billing.savenet.co.ke/portal

# ───────── Android app ─────────
# Where update.sh fetches the Android app (phones and TV boxes) that customers download
# from "My plan > Get the app". Built by .github/workflows/android.yml. Empty = don't fetch.
APP_APK_URL=https://github.com/hasbig36/flex/releases/download/android-latest/flex.apk

# ───────── Who can use the app ─────────
# Only these networks can open the app (comma-separated, IPv4/IPv6 CIDR).
# Leave empty to allow everyone. Others see a "works on our network only" page.
ALLOWED_NETWORKS=102.216.116.0/24,102.216.117.0/24

# ───────── Web address (used by install.sh) ─────────
# Public name for HTTPS, e.g. tv.your-isp.co.ke. Point its DNS at this server first.
FLEX_DOMAIN=tv.savenet.co.ke
FLEX_CERT_EMAIL=hshalleh@savenet.co.ke
# true behind HTTPS (install.sh sets this for you)
COOKIE_SECURE=auto

# ───────── Director approvals ─────────
# Password for the director's approval page at https://<your address>/director
# (install.sh creates one and saves it in /root/flex-credentials.txt)
DIRECTOR_NAME=Director
DIRECTOR_PASSWORD=

# ───────── Portal ─────────
PORTAL_PORT=8080
SESSION_DAYS=30
# Long random string; lets your NOC read GET /api/admin/status
ADMIN_TOKEN=
